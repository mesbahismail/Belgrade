      "cssVars": {
        "theme": {
          "font-belgrade": "var(--font-jakarta), ui-sans-serif, system-ui, sans-serif",
          "color-brand": "var(--brand)",
          "color-brand-foreground": "var(--brand-foreground)",
          "color-brand-soft": "var(--brand-soft)",
          "color-brand-from": "var(--brand-from)",
          "color-brand-to": "var(--brand-to)",
          "color-brand-edge": "var(--brand-edge)",
          "color-surface": "var(--surface)",
          "color-phone-frame": "var(--phone-frame)",
          "color-phone-bezel": "var(--phone-bezel)",
          "color-phone-screen": "var(--phone-screen)",
          "color-phone-card": "var(--phone-card)",
          "color-phone-line": "var(--phone-line)",
          "animate-marquee": "marquee var(--marquee-duration, 45s) linear infinite",
          "animate-typing": "typing 1.1s ease-in-out infinite",
          "animate-card-shine": "card-shine 5s ease-in-out infinite",
          "animate-progress": "progress 6s linear forwards",
          "animate-twinkle": "twinkle 4s ease-in-out infinite"
        },
        "light": {
          "brand": "#5a86b5",
          "brand-foreground": "#ffffff",
          "brand-soft": "#93b2d4",
          "brand-from": "#719dca",
          "brand-to": "#4a77a6",
          "brand-edge": "#42709f",
          "surface": "rgb(255 255 255 / 0.62)",
          "phone-frame": "#ffffff",
          "phone-bezel": "#e3e3e3",
          "phone-screen": "#f4f4f4",
          "phone-card": "#ffffff",
          "phone-line": "#ebebeb",
          "hero-glow": "rgb(255 255 255 / 0.95)"
        },
        "dark": {
          "brand": "#6f9fd4",
          "brand-foreground": "#ffffff",
          "brand-soft": "#6c9cd2",
          "brand-from": "#93b9e2",
          "brand-to": "#5d8dc2",
          "brand-edge": "rgb(255 255 255 / 0.14)",
          "surface": "rgb(52 52 56 / 0.42)",
          "phone-frame": "#151515",
          "phone-bezel": "#2b2b2b",
          "phone-screen": "#0b0b0b",
          "phone-card": "#161616",
          "phone-line": "#232323",
          "hero-glow": "rgb(150 170 200 / 0.06)"
        }
      },
      "css": {
        ":root:has(.belgrade)": {
          "--background": "#eeeeee",
          "--foreground": "#0f0f0f",
          "--card": "#ffffff",
          "--card-foreground": "#0f0f0f",
          "--popover": "#ffffff",
          "--popover-foreground": "#0f0f0f",
          "--primary": "#4a77a6",
          "--primary-foreground": "#ffffff",
          "--secondary": "#f6f6f6",
          "--secondary-foreground": "#0f0f0f",
          "--muted": "#e4e4e4",
          "--muted-foreground": "#6b6b6b",
          "--accent": "#e7e7e7",
          "--accent-foreground": "#0f0f0f",
          "--border": "#d9d9d9",
          "--input": "#d2d2d2",
          "--ring": "#7ea6d1",
          "--radius": "0.75rem"
        },
        ":root.dark:has(.belgrade), .belgrade .dark": {
          "--background": "#080808",
          "--foreground": "#f3f3f3",
          "--card": "#121212",
          "--card-foreground": "#f3f3f3",
          "--popover": "#121212",
          "--popover-foreground": "#f3f3f3",
          "--primary": "#7aa6d6",
          "--primary-foreground": "#ffffff",
          "--secondary": "#161616",
          "--secondary-foreground": "#f3f3f3",
          "--muted": "#1a1a1a",
          "--muted-foreground": "#9a9a9a",
          "--accent": "#1c1c1c",
          "--accent-foreground": "#f3f3f3",
          "--border": "#262626",
          "--input": "#2c2c2c",
          "--ring": "#5f8fc4"
        },
        "@keyframes marquee": {
          "from": {
            "transform": "translateX(0)"
          },
          "to": {
            "transform": "translateX(-50%)"
          }
        },
        "@keyframes typing": {
          "0%, 60%, 100%": {
            "opacity": "0.25",
            "transform": "translateY(0)"
          },
          "30%": {
            "opacity": "1",
            "transform": "translateY(-2px)"
          }
        },
        "@keyframes progress": {
          "from": {
            "transform": "scaleX(0)"
          },
          "to": {
            "transform": "scaleX(1)"
          }
        },
        "@keyframes card-shine": {
          "0%, 55%": {
            "transform": "translateX(0) skewX(-12deg)"
          },
          "100%": {
            "transform": "translateX(560%) skewX(-12deg)"
          }
        },
        "@keyframes twinkle": {
          "0%, 100%": {
            "opacity": "var(--star-opacity, 0.6)",
            "transform": "scale(1)"
          },
          "50%": {
            "opacity": "calc(var(--star-opacity, 0.6) * 0.2)",
            "transform": "scale(0.6)"
          }
        },
        "@layer base": {
          "::view-transition-old(root), ::view-transition-new(root)": {
            "animation": "none",
            "mix-blend-mode": "normal"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".animate-marquee, .animate-card-shine, .animate-progress, .animate-twinkle": {
            "animation": "none"
          }
        }
      },
      "docs": "Belgrade installed. Add suppressHydrationWarning to the <html> tag in app/layout.tsx: the theme script sets the dark class before first paint. Belgrade's palette only applies on pages that render <SiteShell>, so the rest of your app keeps its theme. The contact form is a demo; wire it to a Server Action to send messages.",
      "meta": {
        "framework": "next",
        "pages": [
          "/",
          "/about",
          "/contact",
          "/privacy",
          "/terms"
        ]
      }
    }
  ]
